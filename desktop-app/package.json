{
  "name": "igo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "iGO-Desktop Electron app (React + JS)",
  "main": "electron/main.js",
  "author": "Kabelo Matlakala",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  }
}
