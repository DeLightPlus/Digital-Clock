# WiFi Configuration - Copy this to .env and update with your credentials
# DO NOT commit .env to version control!

# Your home WiFi network SSID
HOME_WIFI_SSID=YourNetworkName

# Your home WiFi network password
HOME_WIFI_PASSWORD=YourPassword

# Optional: iGO-Buddy access point name (default: iGO-Buddy)
# IGO_AP_NAME=iGO-Buddy
